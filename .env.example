# Auntie Angel environment variables
# Copy to .env.local only if you need to change build-time values.
# There is no server-side secret store in this static export.

# Public site URL used for metadata/canonical URLs at build time.
# For local preview you can leave the default or set http://127.0.0.1:8765
NEXT_PUBLIC_SITE_URL=https://auntieangel.app

# AI tutor keys (personal/local build convenience)
# For a static personal build, keys in .env can be embedded into the client bundle
# (see next.config.mjs). Prefer NEXT_PUBLIC_* names if you want to be explicit.
# DO NOT commit real keys or use embedded keys in a shared/public deployment.
# Supported for preconfiguration in this app: GROQ, OPENROUTER, DEEPSEEK
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# NEXT_PUBLIC_GROQ_API_KEY=
# NEXT_PUBLIC_OPENROUTER_API_KEY=
# NEXT_PUBLIC_DEEPSEEK_API_KEY=

# Auntie Ama can also be configured inside the app (Settings → Auntie Ama’s AI);
# settings entered in-app are stored in that browser's local storage.
# For any shared/public deployment, use a server-side proxy instead of direct keys.
# Proxy contract (POST JSON): { provider, model, system, messages } -> { text }
